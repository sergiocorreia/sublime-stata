[
	{
		"caption": "Stata: Run Selection or Buffer",
		"command": "stata_exec",
		"args": { "action": "do" }
	},
	{
		"caption": "Stata: Help for Command",
		"command": "stata_help"
	},
	{
		"caption": "Stata: Toggle save/use",
		"command": "stata_toggle_dataset_io"
	},
	{
		"caption": "Stata: Choose Target Window",
		"command": "stata_choose_target_window"
	},
	{
		"caption": "Stata: Use Most Recent Window",
		"command": "stata_use_recent_window"
	},
	{
		"caption": "Stata: Settings",
		"command": "edit_settings",
		"args":
		{
			"base_file": "${packages}/Stata/Stata.sublime-settings",
			"default": "{\n\t$0\n}\n"
		}
	},
	{
		"caption": "Stata: Documentation",
		"command": "open_file",
		"args": { "file": "${packages}/Stata/README.md" }
	}
]
