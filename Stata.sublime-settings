{
	// Stata source files use literal tabs, matching extra/STATA_STYLE_GUIDE.md.
	"tab_size": 4,
	"translate_tabs_to_spaces": false,
	"rulers": [100],
	"ensure_newline_at_eof_on_save": true,

	// Linux/X11 execution. "activate_restore" briefly activates the target
	// window; "background" delivers without raising it.
	"linux_delivery_mode": "activate_restore",
	"linux_command_focus_keys": ["ctrl+1"],
	// Used for window identity and automatic startup; MP is preferred. Bare
	// names are also checked under /usr/local/stata19 when absent from PATH.
	"linux_stata_executables": ["xstata-mp", "xstata-se", "xstata"],

	// Extra directories searched for user/project ado completions.
	"ado_paths": [],

	// Optional personal overrides placed ahead of the bundled frequency tiers.
	"command_priorities": [],

	// Legacy Windows Automation executable path.
	"stata_path": "",

	"auto_complete_triggers":
	[
		{"selector": "meta.local.stata", "characters": ": "},
		{"selector": "meta.local.extended.stata", "characters": "list"}
	]
}
